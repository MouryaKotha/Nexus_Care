# Environment Variables Example

# Google Gemini API Key (Required for AI features)
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB Connection String (Required for saving appointments and auth)
MONGODB_URI=mongodb+srv://your_username:your_password@cluster0.1hbuzkk.mongodb.net/nexuscare?retryWrites=true&w=majority

# JWT Secret (Used for user authentication)
JWT_SECRET=nexuscare_secret_key_123

# Backend Port
PORT=5000
